# Response headers for the static host. Cloudflare Pages and Netlify both read this file.
# docs/security.md explains why. nuxt.config.ts (routeRules) sets the same headers in `nuxt dev`.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Folders that hold files made from other people's bytes (fetched icons and
# images, uploads). A file here is only ever an <img> source. Opened directly it
# gets no script, no network and no access to the site's origin (sandbox).
/icons/*
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; sandbox
  X-Content-Type-Options: nosniff

/thumbs/*
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; sandbox
  X-Content-Type-Options: nosniff

/blocks/*
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; sandbox
  X-Content-Type-Options: nosniff

/site/*
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; sandbox
  X-Content-Type-Options: nosniff

/site-uploads/*
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; sandbox
  X-Content-Type-Options: nosniff
