    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@iconify-json/line-md": "^1.2.16",
    "@iconify-json/simple-icons": "^1.2.96",
    "@nuxt/eslint": "^1.17.0",
    "eslint": "^10.10.0",
    "tsx": "^4.23.13",
