    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "presets": "tsx scripts/build-presets.ts",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "check:profile": "tsx scripts/validate-profile.ts",
    "check:icons": "tsx scripts/check-icons.ts",
    "fetch:favicons": "tsx scripts/fetch-favicons.ts",
