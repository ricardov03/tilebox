# Stock photos in the editor (optional). Free key: https://www.pexels.com/api/ -> "Your API key".
# Read by the dev server only. Never sent to the browser. Not needed for a build, on CI or to publish.
PEXELS_API_KEY=
# Absolute site URL, no trailing slash. Makes og:image and og:url absolute. Empty = paths only.
NUXT_PUBLIC_SITE_URL=
